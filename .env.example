# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu-clave-publishable
SUPABASE_SECRET_KEY=tu-clave-service-role

# Supabase pública (cliente)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon

# URL pública del sitio (usada para OG images / metadata)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Admin del panel
ADMIN_PASSWORD=cambia-esta-contrasena

# Resend (emails). La API key se genera en resend.com; el dominio del remitente
# debe estar verificado ahí. EMAIL_FROM por defecto: Craft3d <contacto@craft3d.com.ar>
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth (credenciales de Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret del webhook de Mercado Pago (Developers → Webhooks, "Configurar firma").
# Si no está configurado, el webhook igual verifica el pago contra la API de MP.
MERCADOPAGO_WEBHOOK_SECRET=
