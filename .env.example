# MariaDB (Dokploy)
DATABASE_URL="mariadb://dokploy:TU_PASSWORD@localhost:3306/craft3d_db"

# JWT / NextAuth
JWT_SECRET="tu_secreto_super_seguro_aqui"
NEXTAUTH_SECRET="tu_secreto_super_seguro_aqui"
NEXTAUTH_URL="https://tu-dominio.com"

# Admin del panel (cambia esta contraseña)
ADMIN_PASSWORD=Craf3dAdmin!2026

# URL pública del sitio (OG images / metadata)
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# Píxel de Meta (Facebook/Instagram Ads). ID público (no secreto). Sin esto,
# el píxel no se carga y las campañas de Meta no pueden optimizar para compras
# ni retargetear. Se crea en Meta Events Manager → Orígenes de datos → Píxel.
NEXT_PUBLIC_FB_PIXEL_ID=

# Google OAuth (credenciales de Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails transaccionales (Resend). SIN esta API key NO se envía ningún email
# (ni confirmación al cliente, ni aviso de nuevo pedido, ni "pago aprobado").
RESEND_API_KEY=
# Remitente de los emails (debe ser un dominio verificado en Resend).
EMAIL_FROM="Craft3d <contacto@craft3d.com.ar>"
# Email donde recibís el aviso de cada pedido nuevo (por defecto: contacto@craft3d.com.ar).
ADMIN_ORDER_EMAIL=

# Carpeta donde se guardan las imágenes subidas desde el admin.
# IMPORTANTE: en producción debe ser un VOLUMEN PERSISTENTE (Coolify), si no
# las imágenes se pierden en cada redeploy. Si no se setea, usa <cwd>/uploads.
UPLOADS_DIR="/app/uploads"